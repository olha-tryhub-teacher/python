    # [ЗМІНА] Відображення таймера з іконкою годинника
            MDBoxLayout:
                orientation: "horizontal"
                size_hint: None, None
                size: dp(120), dp(40)
                pos_hint: {"center_x": 0.5, "top": 0.97}
                spacing: dp(5)

                MDIcon:
                    icon: "clock-outline"
                    pos_hint: {"center_y": 0.5}

                MDLabel:
                    text: f"{int(root.timer)}s"
                    halign: "left"
                    pos_hint: {"center_y": 0.5}
